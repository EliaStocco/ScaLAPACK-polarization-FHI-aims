  xc                           revpbe0
  relativistic                 atomic_zora scalar
  spin                         none
  k_grid                       2 2 2
  sc_accuracy_rho              1d-4
  elsi_restart                 read
  use_alltoall              .false.
  load_balancing              .true.
  force_complex_eigenvectors  .true.
  output polarization          1   4  2  2
  output polarization          2   2  4  2
  output polarization          3   2  2  4
  
  
  ################################################################################
  #
  #  FHI-aims code project
