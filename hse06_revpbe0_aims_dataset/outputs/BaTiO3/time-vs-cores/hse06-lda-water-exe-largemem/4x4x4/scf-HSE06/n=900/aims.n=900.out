       hydro 4 f 8
       hydro 3 d 2.7
       ionic 4 p auto
  #     hydro 5 g 11.6
  #     ionic 4 s auto
  #  "Second tier" - improvements: -16.30 meV to -2.03 meV
  #     hydro 3 d 4.4
  #     hydro 6 h 16
  #     hydro 4 f 9.4
  #     hydro 4 p 4.5
  #     hydro 1 s 0.5
  #  "Third tier" - improvements: -6.28 meV to -0.37 meV
