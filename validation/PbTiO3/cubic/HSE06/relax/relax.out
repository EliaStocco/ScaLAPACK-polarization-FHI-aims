       hydro 2 p 1.8
       hydro 3 d 7.6
       hydro 3 s 6.4
  #  "Second tier" - improvements: -49.91 meV to -5.39 meV
       hydro 4 f 11.6
       hydro 3 p 6.2
       hydro 3 d 5.6
       hydro 5 g 17.6
       hydro 1 s 0.75
