       hydro 3 p 2.3
       hydro 4 f 7.6
       hydro 3 d 3.5
       hydro 5 g 9.8
       hydro 3 s 3.2
  #  "Second tier" - max. impr. -4.38  meV, min. impr. -0.30 meV
