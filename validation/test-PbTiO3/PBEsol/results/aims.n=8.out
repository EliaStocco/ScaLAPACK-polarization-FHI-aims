      nucleus             22
      mass                47.867
  #
      l_hartree           6
  #
      cut_pot             4.0          2.0  1.0
      basis_dep_cutoff    1e-4
  #
      radial_base         48 7.0
      radial_multiplier   2
      angular_grids       specified
        division   0.3263   50
        division   0.7218  110
        division   1.0925  194
        division   1.3188  302
        division   1.4940  434
