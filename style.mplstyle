# ===============================
# APS PRB / REVTeX 4.2 style
# ===============================

# Use LaTeX for text rendering
text.usetex : True

# Figure size (two-column APS)
figure.figsize : 8, 3

# Font setup
font.family : serif
font.size : 10

# Axes labels
axes.labelsize : 10
axes.titlesize : 10

# Tick labels
xtick.labelsize : 10
ytick.labelsize : 10

# Legend
legend.fontsize : 10
legend.handletextpad : 0.3
legend.loc : best
legend.facecolor : white
legend.edgecolor : black
legend.framealpha : 1

# Line and marker defaults
lines.linewidth : 1.2
lines.markersize : 4

# DPI for vector output
savefig.dpi : 300

# Tight layout works better for journals
figure.autolayout : True
